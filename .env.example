# 复制为 .env 后使用（.env 已被 .gitignore 忽略，真实密钥只放 .env，不要提交）
# 切换 Mock / 真实模型：只改 MODEL_MODE 这一行，代码不用动。

# ------------------------------------------------------------
# 运行模式
#   real = 调用真实模型（下面的 OPENAI_* 三项必须填对，缺任意一项启动直接失败）
#   mock = 本地假模型，不联网、零成本；Agent 循环 / 工具执行 / 事件流仍然是真的
#   auto = 三项都配了走真实模型，缺任意一项自动退回 Mock
# ------------------------------------------------------------
MODEL_MODE=mock

# ------------------------------------------------------------
# 真实模型：任何 OpenAI 兼容端点都行，base_url 决定是哪家
# 代码固定使用 OpenAIChatCompletionClient（打 /chat/completions）。
# 不要换成 OpenAIChatClient（打 /responses）—— DeepSeek 不兼容工具结果回传，
# 第二轮会报 400 "No tool call found for tool output"。详见 README「模型接入」。
# ------------------------------------------------------------
# DeepSeek（本项目实测使用）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# 阿里通义（DashScope 兼容模式）示例：
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen-plus

# ------------------------------------------------------------
# 兼容第三天的旧变量名（可选，二选一即可）
#   MODEL_MODE 若已设置，优先于 APP_LLM_MODE
#   APP_LLM_MODE: auto / openai(=real) / mock
#   APP_LLM_BASE_URL / APP_LLM_MODEL / APP_LLM_API_KEY 优先于同名 OPENAI_*
# ------------------------------------------------------------
# APP_LLM_MODE=auto
# APP_LLM_BASE_URL=
# APP_LLM_MODEL=
# APP_LLM_API_KEY=

# ------------------------------------------------------------
# 练习账号（scripts/seed.py 使用）
# ------------------------------------------------------------
SEED_USERNAME=demo
SEED_PASSWORD=change-me-please
SEED_DISPLAY_NAME=练习用户

# ------------------------------------------------------------
# 服务配置
# ------------------------------------------------------------
APP_SESSION_TTL_SECONDS=1800
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_DB_PATH=./data/app.db

# Mock 模式下的打字间隔（秒），默认 0.05（每 2 字停一下，约 40 字/秒）。
# 设成 0 就是一秒内全吐完，界面上看不到打字过程；只影响 Mock，不影响真实模型。
APP_MOCK_CHUNK_DELAY=0.05

# ------------------------------------------------------------
# 可观测性（OpenTelemetry）
# 链路面板：span 进内存环形缓冲，GET /agent/traces 可读。默认开，关掉填 0。
# 只记录结构信息（操作名、工具名、耗时、token 数），不记录 prompt 与回复原文。
# ------------------------------------------------------------
APP_TRACE_PANEL=1
APP_TRACE_BUFFER_SIZE=400
APP_OTEL_CONSOLE=0
APP_OTEL_SERVICE_NAME=intern-day-2-backend-agent

# ------------------------------------------------------------
# 第五天：久坐活动助手
#   APP_TZ_OFFSET_HOURS     排程用的时区偏移。容器默认 UTC，不设置会差 8 小时。
#   APP_ACTIVITY_DAILY_TARGET 用户没改过设置时的每天次数（1-8）
# ------------------------------------------------------------
APP_TZ_OFFSET_HOURS=8
APP_ACTIVITY_DAILY_TARGET=3

# ------------------------------------------------------------
# 第六天：每日活动总结（Redis + ARQ）
#
#   APP_REDIS_HOST  容器内必须写 compose 服务名 redis。
#                   在容器里写 localhost 指的是容器自己，那里没有 Redis。
#                   本机直接跑 uvicorn/arq 时改成 127.0.0.1。
#   APP_REDIS_*     Redis 连接与库号，队列默认用 0 号库。
#
#   APP_SUMMARY_TIMEZONE  调度与日报日期所用的时区。必须显式给，
#                 容器默认 UTC，不配的话 00:05 会变成北京时间 08:05。
#   APP_SUMMARY_CRON_*    每天什么时候生成前一天的日报。
#                  默认 00:05 —— 用 5 分而不是 0 分，是为了覆盖前一天
#                  23:5x 才完成的记录。演示时把 MINUTE 改成 "*/2"
#                  （每两分钟触发一次），演示完改回来，不要留一个高频定时器。
#   APP_SUMMARY_MAX_TRIES 单条日报任务最多尝试几次（含首次）。
#   APP_SUMMARY_JOB_TIMEOUT 单条任务超时秒数。
#   APP_SUMMARY_KEEP_RESULT 任务结果在 Redis 里的保留秒数。
#                  它决定 _job_id 去重的有效窗口，不能代替数据库唯一约束。
# ------------------------------------------------------------
APP_REDIS_HOST=redis
APP_REDIS_PORT=6379
APP_REDIS_DB=0
APP_SUMMARY_TIMEZONE=Asia/Shanghai
APP_SUMMARY_CRON_HOUR=0
APP_SUMMARY_CRON_MINUTE=5
APP_SUMMARY_MAX_TRIES=3
APP_SUMMARY_JOB_TIMEOUT=120
APP_SUMMARY_KEEP_RESULT=3600
