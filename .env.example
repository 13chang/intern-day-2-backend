# 复制为 .env 后按需修改；.env 不要提交到 Git

# 练习账号（scripts/seed.py 使用）
SEED_USERNAME=demo
SEED_PASSWORD=change-me-please
SEED_DISPLAY_NAME=练习用户

# 服务配置
APP_SESSION_TTL_SECONDS=1800
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_DB_PATH=./data/app.db

# 第三天：模型访问条件（向导师索取，只填在这里，不要提交 .env）
# auto   = 下面三项都填了才走真实模型，缺任意一项退回 Mock
# openai = 强制真实模型，缺配置直接启动失败
# mock   = 强制 Mock，只用来排查链路
APP_LLM_MODE=auto
APP_LLM_BASE_URL=
APP_LLM_MODEL=
APP_LLM_API_KEY=

# Mock 模式下的打字间隔（秒），默认 0.05（每 2 字停一下，约 40 字/秒）。
# 设成 0 就是一秒内全吐完，界面上看不到打字过程；只影响 Mock，不影响真实模型。
APP_MOCK_CHUNK_DELAY=0.05

# 第四天：可观测性（OpenTelemetry）
# 链路面板：span 进内存环形缓冲，GET /agent/traces 可读。默认开，关掉填 0。
# 只记录结构信息（操作名、工具名、耗时、token 数），不记录 prompt 与回复原文。
APP_TRACE_PANEL=1
APP_TRACE_BUFFER_SIZE=400
# 打印 span 到 stdout，排查用；默认关，避免日志噪声
APP_OTEL_CONSOLE=0
APP_OTEL_SERVICE_NAME=intern-day-2-backend-agent
